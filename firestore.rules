// Firestore Security Rules
// Firebase Console > Firestore > Rules 에 아래 내용을 붙여넣으세요.
//
// 적용 방법:
// 1. https://console.firebase.google.com 접속
// 2. ai-literacy-test 프로젝트 선택
// 3. Firestore Database > Rules 탭
// 4. 아래 내용 전체를 복사하여 붙여넣기
// 5. "Publish" 클릭

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 슈퍼관리자 판별 함수
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email in ['greatsong@gmail.com', 'greatsong21@gmail.com'];
    }

    // 해당 학교의 관리자인지 판별
    function isSchoolAdmin(schoolId) {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in get(/databases/$(database)/documents/schools/$(schoolId)).data.admins;
    }

    // === 학교 설정 문서 (schools/{schoolId}) ===
    match /schools/{schoolId} {
      // 누구나 학교 목록 읽기 가능 (학생 학교 선택용)
      allow read: if true;

      // 슈퍼관리자만 생성 가능
      allow create: if isSuperAdmin();

      // 해당 학교 관리자 또는 슈퍼관리자만 수정/삭제 가능
      allow update, delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
    }

    // === 학생 응답 (schools/{schoolId}/responses) ===
    match /schools/{schoolId}/responses/{docId} {
      // 학생: 익명 인증 후 응답 제출 가능
      allow create: if request.auth != null;

      // 해당 학교 관리자 또는 슈퍼관리자만 조회/삭제 가능
      allow read, delete: if isSuperAdmin() || isSchoolAdmin(schoolId);

      // 수정은 불허 (제출 후 변경 방지)
      allow update: if false;
    }

    // === 학교 사용 신청 (pendingSchools) ===
    match /pendingSchools/{docId} {
      // 누구나 신청 가능 (익명 인증)
      allow create: if request.auth != null;

      // 슈퍼관리자만 조회/수정/삭제 가능
      allow read, update, delete: if isSuperAdmin();
    }

    // === 레거시 호환 (기존 results 컬렉션) ===
    match /results/{docId} {
      allow create: if request.auth != null;
      allow read, delete: if isSuperAdmin();
      allow update: if false;
    }
  }
}
